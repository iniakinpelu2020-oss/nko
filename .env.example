# Optional — public, read-only Sanity CMS (production dataset, CDN reads only).
# Leave both blank and the site renders from the bundled fallback content.
VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=production

# Never place write tokens, editor tokens or webhook URLs here.
# Content editing happens in Sanity Studio; publishing happens via Cloudflare Pages deploy hooks.
