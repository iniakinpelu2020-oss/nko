/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://cdn.sanity.io https://images.unsplash.com; connect-src 'self' https://*.apicdn.sanity.io https://*.api.sanity.io; frame-src 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
  X-XSS-Protection: 0

# Hashed build output can be cached forever; the shell must always revalidate so
# a new deployment is picked up immediately (a stale shell pointing at a missing
# hashed file is one way a SPA ends up blank).
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/media/*
  Cache-Control: public, max-age=604800

/_headers
  Cache-Control: public, max-age=0, must-revalidate

/_redirects
  Cache-Control: public, max-age=0, must-revalidate
